{
  "name": "doorei",
  "version": "0.1.0",
  "private": true,
  "description": "A personal recall library for downloaded video courses",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-models": "node --experimental-strip-types scripts/fetch-models.ts",
    "package": "pnpm fetch-models && pnpm build && electron-builder",
    "postinstall": "node node_modules/electron/install.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static",
      "onnxruntime-node"
    ]
  },
  "build": {
    "appId": "dev.doorei.app",
    "productName": "Doorei",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/out/main/shenavaWorker.js",
      "**/out/main/chunks/**"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.41",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.65",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.31.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
